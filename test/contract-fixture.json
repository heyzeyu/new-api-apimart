        "openai_video",
        "decodeRequest"
      ],
      "args": [
        {
          "model": "kling-v3",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "fixture",
              "seconds": 0
            }
          }
        }
      ],
      "expectedError": "duration must"
