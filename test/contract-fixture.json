    {
      "name": "completed without media is not success",
      "hook": "parseTaskResult",
      "args": [
        {
          "model": "gpt-image-2"
        },
        {
          "code": 200,
          "data": {
            "status": "completed",
            "result": {
              "images": [
                {
                  "revised_prompt": "fixture"
                }
              ]
            }
          }
        }
      ],
      "expected": {
        "status": "UNKNOWN",
        "reason": "APIMart completed without a media result"
      }
