    {
      "name": "CDN requests carry no channel credentials",
      "hook": "buildContentRequest",
      "args": [
        {
          "artifactKey": "image_0",
          "apiKey": "fixture-only",
          "clientRequest": {
            "method": "GET"
          },
          "data": {
            "data": {
              "result": {
                "images": [
                  {
                    "url": [
                      "https://cdn.example/image.png"
                    ]
                  }
                ]
              }
            }
          }
        }
      ],
      "expected": {
        "url": "https://cdn.example/image.png",
        "method": "GET",
        "credentialless": true
      }
    },
    {
      "name": "chained New API queries use native prefix",
      "hook": "buildQueryRequest",
      "args": [
        {
          "baseUrl": "https://gateway.example",
          "apiKey": "fixture-only",
          "taskId": "task_public",
          "upstream": {
            "kind": "new_api"
          }
        }
      ],
      "expected": {
        "url": "https://gateway.example/apimart/v1/tasks/task_public",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer fixture-only"
        }
      }
    },
    {
      "name": "Ext create response preserves public identity",
      "hook": "native",
      "path": [
        "taskCreated"
      ],
      "args": [
        {},
        {
          "task_id": "task_public",
          "data": {
            "data": {
              "id": "task_fixture",
              "object": "generation.task"
            }
          }
        }
      ],
      "expected": {
        "code": 200,
        "data": {
          "id": "task_public",
          "object": "generation.task",
          "type": "image",
          "status": "pending",
          "progress": 0,
          "poll_url": "/apimart/v1/tasks/task_public"
        }
      }
    },
    {
      "name": "plain Image 2 cannot silently accept high",
      "hook": "native",
      "path": [
        "decodeImage"
      ],
      "args": [
        {
          "model": "gpt-image-2",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "fixture",
              "quality": "high"
            }
          }
        }
      ],
      "expectedError": "quality is not supported"
    },
    {
      "name": "token image count is bounded",
      "hook": "native",
      "path": [
        "decodeImage"
      ],
      "args": [
        {
          "model": "gpt-image-2.5-flare",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "fixture",
              "n": 5
            }
          }
        }
      ],
      "expectedError": "n must"
    },
    {
      "name": "nested count is bounded",
      "hook": "native",
      "path": [
        "decodeImage"
      ],
      "args": [
        {
          "model": "gpt-image-2.5-flare",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "fixture",
              "metadata": {
                "n": 2147483648
              }
            }
          }
        }
      ],
      "expectedError": "n must"
    },
    {
      "name": "transparent JPEG is rejected",
      "hook": "native",
      "path": [
        "decodeImage"
      ],
      "args": [
        {
          "model": "gpt-image-2.5-flare",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "fixture",
              "background": "transparent",
              "output_format": "jpeg"
            }
          }
        }
      ],
      "expectedError": "PNG or WebP"
    },
    {
      "name": "unaligned token image dimensions are rejected",
      "hook": "native",
      "path": [
        "decodeImage"
      ],
      "args": [
        {
          "model": "gpt-image-2.5-flare",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "fixture",
              "size": "1664x2225"
            }
          }
        }
      ],
      "expectedError": "dimensions"
    },
    {
      "name": "request callback cannot bypass gateway",
      "hook": "native",
      "path": [
        "decodeImage"
      ],
      "args": [
        {
          "model": "gpt-image-2",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "fixture",
              "webhook": "https://callback.example"
            }
          }
        }
      ],
      "expectedError": "callback"
    },
    {
      "name": "video duration zero is rejected",
      "hook": "protocols",
